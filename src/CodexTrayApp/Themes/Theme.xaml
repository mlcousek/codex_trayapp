<!-- Theme tokens. Views reference these keys only; never a literal colour, font or duration.
     Colours come from the palette dictionary ThemeManager merges (Palette.Dark.xaml or Palette.Light.xaml). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Brushes -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{DynamicResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{DynamicResource HairlineColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{DynamicResource OkColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="Chart1Brush" Color="{DynamicResource Chart1Color}" />
    <SolidColorBrush x:Key="Chart2Brush" Color="{DynamicResource Chart2Color}" />
    <SolidColorBrush x:Key="Chart3Brush" Color="{DynamicResource Chart3Color}" />
    <SolidColorBrush x:Key="Chart4Brush" Color="{DynamicResource Chart4Color}" />
    <SolidColorBrush x:Key="Chart5Brush" Color="{DynamicResource Chart5Color}" />

    <!-- Type: Segoe UI Variable with Segoe UI as the fallback. Numbers always use tabular figures. -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeNumeral">22</sys:Double>
    <sys:Double x:Key="FontSizeHero">28</sys:Double>

    <!-- Spacing, radius, motion -->
    <sys:Double x:Key="SpaceXs">4</sys:Double>
    <sys:Double x:Key="SpaceS">8</sys:Double>
    <sys:Double x:Key="SpaceM">12</sys:Double>
    <sys:Double x:Key="SpaceL">16</sys:Double>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <Duration x:Key="MotionFast">0:0:0.15</Duration>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
</ResourceDictionary>
