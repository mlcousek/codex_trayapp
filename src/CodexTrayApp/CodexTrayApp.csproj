<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF app: composition root, views and viewmodels. Transport and parsing live in CodexTrayApp.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- LibraryImport-generated interop needs this; no hand-written unsafe code exists. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The project's own icon, generated by tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>CodexTrayApp</RootNamespace>
    <AssemblyName>CodexTrayApp</AssemblyName>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Publish shape: self-contained single file, ReadyToRun, no trimming (WPF is not trim-safe).
       Only applied by `dotnet publish`; regular builds stay framework-dependent and fast. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pricing ships next to the binary and is user-editable; prices are never hardcoded. -->
    <None Include="pricing.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexTrayApp.Core\CodexTrayApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodexTrayApp.Tests" />
    <AssemblyMetadata Include="ReleaseRepository" Value="$(ReleaseRepository)" />
  </ItemGroup>

</Project>
